# Worker URL (no API keys in frontend).
# Local:  VITE_WORKER_URL=http://localhost:8787
# Prod:   VITE_WORKER_URL=https://xau-ai-backend.YOUR-SUBDOMAIN.workers.dev
# API keys live only in Cloudflare Worker secrets (wrangler secret put),
# never in git — this keeps push protection happy.
VITE_WORKER_URL=http://localhost:8787
